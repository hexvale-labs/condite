default: help

# Show the shared command guide.
help:
    @just --justfile ../../justfile help

# Install JS dependencies, fetch all Rust crates, and prepare WASM tooling.
[working-directory: "../.."]
install:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> Install: SDK"
    bun install --frozen-lockfile
    cargo fetch --locked
    cargo fetch --locked --manifest-path examples/sdk-consumer/Cargo.toml
    rustup target add wasm32-unknown-unknown
    version=$(awk '/^name = "wasm-bindgen"$/ {found=1; next} found && /^version =/ {gsub(/"/, "", $3); print $3; exit}' Cargo.lock)
    if ! "${WASM_BINDGEN:-wasm-bindgen}" --version 2>/dev/null | grep -Fxq "wasm-bindgen $version"; then
        cargo install wasm-bindgen-cli --version "$version" --locked
    fi

# Regenerate shared types and build Rust, Node, and WASM artifacts.
[working-directory: "../.."]
build:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> Build: SDK"
    types=$(mktemp)
    trap 'rm -f "$types"' EXIT
    cargo run --quiet --locked -p condite-shared --features typescript --example export-types > "$types"
    cp "$types" crates/condite-shared/bindings.d.ts
    bun run build:sdk

# Build and validate bindings, or use `check tools` for setup diagnostics.
[working-directory: "../.."]
check target="all":
    #!/usr/bin/env bash
    set -euo pipefail
    case {{quote(target)}} in
        tools) just check tools sdk ;;
        all)
            just build sdk
            bun run check:consumer
            bun run lint:sdk
            bun run test:sdk
            just check wasm ;;
        *) echo 'Use check [all|tools]' >&2; exit 2 ;;
    esac
