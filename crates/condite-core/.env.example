# Only variables explicitly referenced by condite.toml are read.
S3_ENDPOINT=https://s3.example
S3_REGION=us-east-1
S3_BUCKET=condite
S3_ACCESS_KEY=example-access-key
S3_SECRET_KEY=replace-with-provider-secret
# Required: choose a random root credential of at least 32 printable ASCII characters.
CONDITE_OPERATOR_KEY=
