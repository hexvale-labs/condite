# SQL
SQL_CONN_URL=turso:./condite.db

# S3
S3_ENDPOINT=https://42.cloudflarestorage.com
S3_REGION=us-west-2
S3_BUCKET=condite
S3_ACCESS_KEY=42
S3_SECRET_KEY=42
# Optional direct sharing: a DIFFERENT bucket with anonymous GET only.
# Originals in S3_BUCKET must remain private. No public domain is assumed.
S3_PUBLIC_BUCKET=condite-public
PUBLIC_OBJECT_BASE_URL=https://storage.example/condite-public
