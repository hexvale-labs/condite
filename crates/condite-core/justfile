default: help

# Show the shared command guide.
help:
    @just --justfile ../../justfile help

# Fetch locked Rust dependencies and create local configuration if absent.
install:
    @echo "==> Install: backend"
    cargo fetch --locked
    test -e .env || cp .env.example .env
    @echo 'Configure .env with your database and S3 settings, then run just run.'

# Build the backend using locked dependencies.
build:
    @echo "==> Build: backend"
    cargo build --locked --bin condite-core

# Start the API on port 8080 using this directory's .env.
run:
    cargo run --locked --bin condite-core

migrate name:
    cargo run --locked --bin migrate -- migration generate --name "{{name}}"

# Run Rust validation, or use `check tools` for setup diagnostics.
check target="rust":
    @bash -c 'if [[ "$1" == tools ]]; then just --justfile ../../justfile check tools backend; elif [[ "$1" == rust ]]; then just --justfile ../../justfile check rust; else echo "Use check [rust|tools]" >&2; exit 2; fi' -- {{quote(target)}}
