
# Voiden
**/.voiden/*
!**/.voiden/env-public.yaml
!**/.voiden/env-*-public.yaml
.voiden-inherited.void

# Rust build artifacts
**/target/

# SDK tooling and generated platform artifacts
node_modules/
crates/condite-sdk-node/dist/
crates/condite-sdk-wasm/dist/
# Also ignore a symlink to an external dependency directory.
/node_modules
/release-assets/
/target
/crates/condite-sdk-node/dist
/crates/condite-sdk-wasm/dist

# Local deployment secrets and runtime config
.env
condite.toml
dashboard.toml
ctl.toml

clients/dashboard/dashboard.test.toml

/clients/vencord-extension/.vencord

!docker/examples/dashboard.toml
