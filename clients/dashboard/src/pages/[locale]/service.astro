---
import Admin from '../../layouts/Admin.astro';
import Service from '../../components/Service';
import { isLocale } from '../../i18n';
import { serverClient, withSsrDeadline } from '../../lib/server';
import type { HealthStatus } from 'condite-sdk-node';
const { locale } = Astro.params;
if (!isLocale(locale)) return new Response(null, { status: 404 });
Astro.response.headers.set('Cache-Control', 'no-store');
let initial: HealthStatus | null = null;
try { initial = await withSsrDeadline(serverClient().health()); } catch { /* Keep the administration shell available offline. */ }
---
<Admin locale={locale} section="service" health={initial}><Service locale={locale} initial={initial} client:load /></Admin>
