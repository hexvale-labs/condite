{
  "name": "@condite/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun --bun astro dev",
