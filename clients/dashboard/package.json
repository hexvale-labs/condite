    "@solidjs/web": "2.0.0-rc.20",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.4",
    "astro-solid-next": "0.1.0",
    "condite-sdk-node": "workspace:*",
    "condite-sdk-wasm": "workspace:*",
    "solid-js": "2.0.0-rc.20",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "catalog:",
    "@solidjs/vite-plugin": "3.0.0-next.54",
    "@types/node": "22.19.15",
    "typescript": "catalog:"
