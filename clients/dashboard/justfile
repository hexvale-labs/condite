default: help

# Show the shared command guide.
help:
    @just --justfile ../../justfile help

# Install workspace dependencies and build the SDK packages.
install:
    @echo "==> Install: dashboard"
    just --justfile ../../scripts/sdk/justfile install
    just --justfile ../../scripts/sdk/justfile build
    test -e .env || cp .env.example .env

# Build the production dashboard (run install first).
build:
    @echo "==> Build: dashboard"
    bun run build

# Start the dashboard on port 4321 (start the backend in another terminal).
run:
    bun run dev

# Validate the dashboard, or use `check tools` for setup diagnostics.
check target="all":
    @bash -c 'if [[ "$1" == tools ]]; then just --justfile ../../justfile check tools dashboard; elif [[ "$1" == all ]]; then bun run check && bun run test:unit && bun run build && bun run test && bun run test:dev; else echo "Use check [all|tools]" >&2; exit 2; fi' -- {{quote(target)}}
